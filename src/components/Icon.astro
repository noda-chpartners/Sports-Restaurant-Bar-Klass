---
interface Props {
  name: 'arrow' | 'calendar' | 'clock' | 'instagram' | 'map' | 'phone' | 'users';
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

<svg
  class:list={['icon', className]}
  viewBox="0 0 24 24"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow' && <path d="M5 12h14m-5-5 5 5-5 5" />}
  {name === 'calendar' && (
    <>
      <path d="M5 3v3m14-3v3M4 9h16M5 5h14a1 1 0 0 1 1 1v14H4V6a1 1 0 0 1 1-1Z" />
      <path d="M8 13h3v3H8z" />
    </>
  )}
  {name === 'clock' && (
    <>
      <circle cx="12" cy="12" r="9" />
      <path d="M12 7v5l3 2" />
    </>
  )}
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle class="icon__dot" cx="17.4" cy="6.6" r="1" />
    </>
  )}
  {name === 'map' && (
    <>
      <path d="M12 21s7-6.1 7-12a7 7 0 1 0-14 0c0 5.9 7 12 7 12Z" />
      <circle cx="12" cy="9" r="2.3" />
    </>
  )}
  {name === 'phone' && <path d="M8.1 3.7 5.8 5.9c-.7.7.2 3.3 2.7 5.9s5.2 3.6 5.9 2.9l2.2-2.3 3.7 3.2-1.6 2.2c-1.4 1.8-4.6 1.2-8.9-2.4S3.2 8.1 4.5 6.3l1.7-2.1 1.9-.5Z" />}
  {name === 'users' && (
    <>
      <circle cx="9" cy="8" r="3" />
      <path d="M3.5 19v-2.1c0-2.7 2.3-4.9 5.1-4.9h.8c2.8 0 5.1 2.2 5.1 4.9V19" />
      <path d="M15 5.4a3 3 0 0 1 0 5.2m1.5 2.2c2.3.5 4 2.5 4 4.9V19" />
    </>
  )}
</svg>
