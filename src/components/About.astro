---
import { Image } from 'astro:assets';
import burgerVisual from '../assets/images/klass-interior-table.jpg';
import staffIllustration from '../assets/images/klass-staff-illustration.jpg';
import { facts } from '../data/siteContent';
import SectionHeading from './SectionHeading.astro';
---

<section class="about section" id="about">
  <div class="about__inner container">
    <div class="about__visual" data-reveal>
      <div class="about__image-wrap">
        <Image
          class="about__image"
          src={burgerVisual}
          alt="アメリカンクランチーチキンバーガーの告知ビジュアル"
          widths={[480, 720, 960]}
          sizes="(max-width: 820px) 100vw, 46vw"
        />
      </div>
      <span class="about__index" aria-hidden="true">01</span>
    </div>

    <div class="about__content">
      <SectionHeading
        eyebrow="WELCOME TO KLASS"
        title="食事も、スポーツも、仲間との時間も。"
        text="Klassは、ランチから深夜までご利用いただけるSports Restaurant & Barです。相模大野駅から徒歩3分。お一人での食事から、グループでのパーティーまでお楽しみいただけます。"
      />

      <dl class="about__facts" data-reveal>
        {facts.map((fact) => (
          <div class="about__fact">
            <dt class="about__fact-label">{fact.label}</dt>
            <dd class="about__fact-value">{fact.value}</dd>
          </div>
        ))}
      </dl>

      <div class="about__character" data-reveal>
        <Image
          class="about__character-image"
          src={staffIllustration}
          alt="料理を運ぶKlassのキャラクターイラスト"
          width={190}
        />
        <p class="about__character-copy">
          <span class="about__character-label">WELCOME TO KLASS</span>
          <span class="about__character-text">GOOD FOOD, GOOD TIMES.</span>
        </p>
      </div>
    </div>
  </div>
</section>
