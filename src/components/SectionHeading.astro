---
interface Props {
  eyebrow: string;
  title: string;
  text?: string;
  theme?: 'light' | 'dark';
}

const { eyebrow, title, text, theme = 'dark' } = Astro.props;
---

<div class:list={['section-heading', `section-heading--${theme}`]} data-reveal>
  <p class="section-heading__eyebrow">{eyebrow}</p>
  <h2 class="section-heading__title">{title}</h2>
  {text && <p class="section-heading__text">{text}</p>}
</div>
