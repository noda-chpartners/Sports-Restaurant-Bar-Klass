---
import { site } from '../data/siteContent';
import Icon from './Icon.astro';
import SectionHeading from './SectionHeading.astro';

const mapEmbed = `https://www.google.com/maps?q=${encodeURIComponent(site.address)}&output=embed`;
---

<section class="access section" id="access">
  <div class="access__inner container">
    <div class="access__map-wrap" data-reveal>
      <iframe
        class="access__map"
        src={mapEmbed}
        title="Sports Restaurant&Bar Klass 周辺地図"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>

    <div class="access__content">
      <SectionHeading eyebrow="ACCESS" title="相模大野駅から徒歩3分。" />
      <div class="access__details" data-reveal>
        <div class="access__detail">
          <Icon name="map" class="access__detail-icon" />
          <div class="access__detail-body">
            <p class="access__detail-label">ADDRESS</p>
            <p class="access__detail-value">{site.address}</p>
          </div>
        </div>
        <div class="access__detail">
          <Icon name="clock" class="access__detail-icon" />
          <div class="access__detail-body">
            <p class="access__detail-label">OPEN</p>
            {site.hours.map((hour) => (
              <p class="access__detail-value">{hour.label}　{hour.value}</p>
            ))}
            <p class="access__detail-note">定休日：{site.closed}</p>
          </div>
        </div>
        <div class="access__detail">
          <Icon name="users" class="access__detail-icon" />
          <div class="access__detail-body">
            <p class="access__detail-label">SEATS</p>
            <p class="access__detail-value">{site.seats} / {site.privateParty}</p>
          </div>
        </div>
      </div>

      <div class="access__actions" data-reveal>
        <a class="button button--red" href={site.mapsUrl} target="_blank" rel="noreferrer">
          <Icon name="map" class="button__icon" />
          <span class="button__label">Google Mapsで見る</span>
        </a>
        <a class="access__phone" href={site.phoneHref}>
          <span class="access__phone-label">TEL</span>
          <span class="access__phone-number">{site.phone}</span>
        </a>
      </div>
    </div>
  </div>
</section>
